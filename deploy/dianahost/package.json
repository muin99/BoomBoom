{
  "name": "gridwise-dianahost",
  "version": "1.0.0-dianahost.1",
  "private": true,
  "description": "GridWise LLM directive interpretation and optimal campus energy scheduling",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "start": "node app.js",
    "start:dev": "node scripts/dev.cjs",
    "test": "npm run build && node --test test/*.test.cjs",
    "test:live": "npm run build && node scripts/live-test.cjs",
    "test:samples": "npm run build && node scripts/test-samples.cjs",
    "check:key": "npm run test:live -- --smoke",
    "export:openapi": "npm run build && node scripts/export-openapi.cjs",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.cjs\" \"scripts/*.cjs\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.cjs\" \"scripts/*.cjs\"",
    "test:judge": "npm run build && node scripts/judge-audit.cjs"
  },
  "engines": {
    "node": "^20.20.2 || ^22.12.0 || >=24.0.0"
  },
  "dependencies": {
    "@nestjs/common": "11.2.5",
    "@nestjs/core": "11.2.5",
    "@nestjs/platform-express": "11.2.5",
    "@nestjs/swagger": "11.4.7",
    "dotenv": "17.4.2",
    "javascript-lp-solver": "1.0.3",
    "openai": "6.49.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.5",
    "@types/node": "20.19.0",
    "prettier": "3.9.8",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@nestjs/platform-express": {
      "multer": "2.4.0"
    }
  }
}
